      "title": "Ingestion and Discovery",
      "items": [
        "Advisor submits a public LinkedIn URL through FastAPI POST /api/research",
        "Discovery Agent queries public web sources and stores evidence snapshots",
        "Raw snapshots are hashed and stored for provenance tracking"
      ]
    },
    {
      "dot": "emerald",
      "title": "Adversarial Verification",
      "items": [
        "Claim Auditor decomposes text into discrete, falsifiable atomic claims",
        "Verification Engine independently corroborates each claim against primary sources",
        "Unverified or contradictory claims are systematically routed to Refusal Engine"
      ]
    },
    {
      "dot": "rose",
      "title": "Human Gate and Delivery",
      "items": [
        "Advisors review 3 strategic presence gaps with full audit receipts",
        "FastAPI exposes claim override and prospect approval endpoints",
        "Diagnostic API returns Markdown and JSON exports with the audit trail"
      ]
    }
